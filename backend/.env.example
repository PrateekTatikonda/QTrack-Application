# QTrack backend configuration
# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=qtrack
DB_PASSWORD=change_me
DB_NAME=qtrack_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,*
LOG_LEVEL=INFO

# --- AI agent (Groq) ---
GROQ_API_KEY=your_groq_api_key
AI_MODEL=qwen/qwen3.8-27b
# Base URL the AI agent uses to reach this API
INTERNAL_API_BASE_URL=http://localhost:8000

# --- WhatsApp Business API (optional) ---
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# --- Hospital configuration ---
HOSPITAL_NAME=QTrack Hospital
HOSPITAL_BRANCHES=main,north,south,east
DEFAULT_BRANCH=main
MEDICAL_SERVICES=general,cardiology,orthopedics,dermatology,pediatrics,gynecology,emergency,ent,neurology
